#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <locale/keys_en_gb.h>

#define BASE  0
#define NAV   1
#define SYM   2
#define NUM   3
#define SYS   4
#define TOUCH 5

#define S_APP LG(TAB)       // Switch app (Mac)
#define B_BCK LG(LEFT)      // Browser back
#define B_FWD LG(RIGHT)     // Browser forward
#define SPC_L LA(LG(LEFT))  // Mac desktop
#define SPC_R LA(LG(RIGHT)) // Mac desktop
#define L_BEG LG(LEFT)      // Line beginning (Mac)
#define L_END LG(RIGHT)     // Line end (Mac)
#define LANG  LC(SPACE)     // Switch lang (Mac)
#define FINDR LG(SPACE)     // Finder or Raycast (Mac)

&is_touching_processor {
    // Set the current layer to TOUCH when the trackpad is touched 
    bindings = <&mo TOUCH>;
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <NAV SYM>;
            then-layer = <NUM>;
        };
    };
    
    behaviors {
        magic: magic_keys {
            compatible = "zmk,behavior-magic-keys";
            #binding-cells = <1>;
            magic-rules = <
                A O
                G S
                H Y
                U E
                X T
                Y H
            >;
            skip-magic-rules = <
                A O
                B N
                D T
                F S
                G S
                H Y
                J Y
                K T
                L R
                M K
                O A
                P N
                Q E
                R L
                U E
                V T
                X T
                Y H
                COMMA I
                DOT I
                MINUS I
                SLASH A
                SEMI E
            >;
        };

        skq: sticky_key_quick_release {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            bindings = <&kp>;
            release-after-ms = <2000>;
            quick-release;
            ignore-modifiers;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "base";
            bindings = <
                &kp FINDR &kp J &kp B &kp G &kp D &kp K   &kp Z      &kp C     &kp O     &kp U    &kp COMMA &mo 4
                &kp Q     &kp H &kp N &kp S &kp T &kp M   &magic 0   &magic 1  &kp A     &kp E    &kp I     &kp MINUS
                &kp LGUI  &kp Y &kp P &kp F &kp V &kp X   &kp SQT    &kp W     &kp SLASH &kp SEMI &kp DOT   &none
                                &mo NAV     &kp R &kp L   &kp LSHIFT &kp SPACE &mo SYM
            >;
        };

        nav {
            display-name = "nav";
            bindings = <
                &none &kp TAB     &kp S_APP  &none     &none     &kp C_VOL_UP  &kp HOME &kp L_BEG &kp UP    &kp L_END &kp DEL   &none
                &none &skq LSHIFT &skq LCTRL &skq LALT &skq LGUI &kp C_VOL_DN  &kp CAPS &kp LEFT  &kp DOWN  &kp RIGHT &kp BSPC  &none
                &none &kp SPC_L   &kp SPC_R  &kp B_BCK &kp B_FWD &kp C_PP      &kp END  &kp PG_DN &kp PG_UP &kp LANG  &kp ENTER &none
                                             &trans    &trans    &trans        &trans   &trans    &trans
            >;
        };

        sym {
            display-name = "sym";
            bindings = <
                &none &kp ESC   &kp LBKT      &kp LBRC    &kp LPAR  &kp LS(NUHS) &kp CARET  &kp RPAR    &kp RBRC  &kp RBKT   &kp GB_GRAVE &none
                &none &kp MINUS &kp STAR      &kp EQUAL   &kp UNDER &kp DLLR     &kp NUHS   &skq LGUI   &skq LALT &skq LCTRL &skq LSHIFT  &none
                &none &kp PLUS  &kp GB_PIPE   &kp LS(N2)  &kp SLASH &kp LS(N5)   &kp LS(N3) &kp GB_BSLH &kp AMPS  &kp QMARK  &kp EXCL     &none
                                              &trans      &trans    &trans       &trans     &trans      &trans
            >;
        };

        num {
            display-name = "num";
            bindings = <
                &none &kp N7      &kp N5     &kp N3    &kp N1    &kp N9   &kp N8  &kp N0    &kp N2    &kp N4     &kp N6      &none
                &none &skq LSHIFT &skq LCTRL &skq LALT &skq LGUI &kp F11  &kp F10 &skq LGUI &skq LALT &skq LCTRL &skq LSHIFT &none
                &none &kp F7      &kp F5     &kp F3    &kp F1    &kp F9   &kp F8  &kp F12   &kp F2    &kp F4     &kp F6      &none
                                               &trans   &trans   &trans   &trans  &trans   &trans
            >;
        };

        sys {
            display-name = "sys";
            bindings = <
                &none          &out OUT_TOG &none        &none        &none        &sys_reset    &studio_unlock &none &none &none &none &none 
                &bt BT_CLR     &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4  &none          &none &none &none &none &none
                &bt BT_CLR_ALL &none        &none        &none        &none        &bt BT_DISC   &none          &none &none &none &none &sys_reset
                                                         &none        &none        &none         &none &none &none
            >;
        };

        touch {
            display-name = "tch";
            bindings = <
                &none &none      &none     &none    &none     &none      &mkp LCLK &mkp MB4 &mkp MB5 &none &none &none
                &none &kp LSHIFT &kp LCTRL &kp LALT &kp LGUI  &mkp MCLK  &mkp RCLK &none    &none    &none &none &to BASE
                &none &none      &none     &none    &none     &none      &mkp MCLK &none    &none    &none &none &none 
                                           &mo NAV  &mkp LCLK &mkp RCLK  &none     &none    &mo SYM
            >;
        };
    };
};
